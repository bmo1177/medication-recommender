# Copy to .env if you want overrides: cp .env.example .env
# main.py reads PORT/HOST/DEBUG/SECRET_KEY from the environment; defaults work with no .env.

PORT=5000
HOST=0.0.0.0
DEBUG=false
MAX_SYMPTOMS=30
MAX_INPUT_LEN=2000
# REQUIRED in production (CSRF + sessions). Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
